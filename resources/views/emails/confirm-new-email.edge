@mjml({
  keepComments: false,
  fonts: {
    Inter: 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap',
  },
})
  <mjml>
    <mj-head>
      <mj-attributes>
        <mj-all font-family="Inter, Arial, sans-serif" />
        <mj-text font-size="15px" line-height="1.65" color="#1f2937" />
        <mj-button
          background-color="#f4b400"
          color="#111827"
          border-radius="10px"
          font-size="15px"
          font-weight="700"
          inner-padding="14px 22px"
        />
      </mj-attributes>
    </mj-head>
    <mj-body background-color="#0f172a" width="640px">
      <mj-section background-color="#1d2a45" padding="26px 24px 18px 24px" border-radius="14px 14px 0 0">
        <mj-column>
          <mj-image
            src="https://raw.githubusercontent.com/CrzGames/Crzgames_AssetsStaticPublic/main/logo/app-icon.png"
            width="58px"
            align="center"
            padding="0 0 10px 0"
          />
          <mj-text align="center" color="#ffffff" font-size="24px" font-weight="700" padding="0 0 4px 0">
            CrzGames
          </mj-text>
          <mj-text align="center" color="#aebbd4" font-size="13px" padding="0">
            Account & Security Notification
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#f8fafc" padding="28px 26px 20px 26px">
        <mj-column>
          <mj-text color="#0f172a" font-size="27px" font-weight="700" padding="0 0 6px 0">
            Email Updated Successfully
          </mj-text>
          <mj-text color="#334155" padding="0 0 14px 0">
            Hello {{ username }}, your account email address has been updated.
          </mj-text>
          <mj-text
            color="#14532d"
            background-color="#dcfce7"
            border-radius="10px"
            padding="12px 14px"
            font-size="13px"
            font-weight="600"
          >
            If you did not perform this change, contact support immediately.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#f8fafc" padding="0 26px 24px 26px">
        <mj-column>
          <mj-button href="{{ redirect_uri }}" padding="0 0 14px 0">
            Open CrzGames
          </mj-button>
          <mj-text color="#64748b" font-size="12px" padding="0">
            You can review your account settings anytime from your profile page.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#1d2a45" padding="18px 24px 24px 24px" border-radius="0 0 14px 14px">
        <mj-column>
          <mj-text align="center" color="#b7c3da" font-size="12px" padding="0">
            Need help? Contact us at support@crzgames.com
          </mj-text>
          <mj-text align="center" color="#7f8da7" font-size="11px" padding="6px 0 0 0">
            (c) CrzGames. All rights reserved.
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-body>
  </mjml>
@end
